{
  "name": "the-vault",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check:url": "esbuild scripts/check-url-canonical.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/check-url.mjs --log-level=error && node node_modules/.cache/check-url.mjs",
    "check:facets": "esbuild scripts/check-facets.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/check-facets.mjs --log-level=error && node node_modules/.cache/check-facets.mjs",
    "check": "npm run check:url && npm run check:facets && npm run check:store",
    "check:store": "esbuild scripts/check-store.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/check-store.mjs --log-level=error && node node_modules/.cache/check-store.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.454.0",
    "minisearch": "^7.2.0",
    "motion": "^12.23.25",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.17",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.22",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.6.3",
    "vite": "^6.0.1"
  }
}
